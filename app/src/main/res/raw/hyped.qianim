<?xml version="1.0" encoding="utf-8"?>
<Animation typeVersion="2.0" xmlns:editor="http://www.aldebaran.com/animation/editor">

  <!-- Phase 1 (frames 1-15): Arms shoot up fast -->
  <!-- Phase 2 (frames 15-65): Head shakes while arms stay raised, slight pump -->
  <!-- Phase 3 (frames 65-90): Both arms lower fully back to neutral, with settle hold -->

  <ActuatorCurve fps="25" actuator="LShoulderPitch" mute="false" unit="radian">
    <Key value="1.55" frame="1">
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-1.3" frame="15">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-1.5" frame="35">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-1.2" frame="50">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-1.5" frame="65">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="1.55" frame="84">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="1.55" frame="90">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
  </ActuatorCurve>

  <ActuatorCurve fps="25" actuator="RShoulderPitch" mute="false" unit="radian">
    <Key value="1.55" frame="1">
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-1.3" frame="15">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-1.5" frame="35">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-1.2" frame="50">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-1.5" frame="65">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="1.55" frame="84">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="1.55" frame="90">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
  </ActuatorCurve>

  <ActuatorCurve fps="25" actuator="LShoulderRoll" mute="false" unit="radian">
    <Key value="0.15" frame="1">
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.6" frame="15">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.6" frame="65">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.15" frame="84">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.15" frame="90">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
  </ActuatorCurve>

  <ActuatorCurve fps="25" actuator="RShoulderRoll" mute="false" unit="radian">
    <Key value="-0.15" frame="1">
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.6" frame="15">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.6" frame="65">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.15" frame="84">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.15" frame="90">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
  </ActuatorCurve>

  <ActuatorCurve fps="25" actuator="LElbowRoll" mute="false" unit="radian">
    <Key value="-0.5" frame="1">
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.2" frame="15">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.2" frame="65">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.5" frame="84">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.5" frame="90">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
  </ActuatorCurve>

  <ActuatorCurve fps="25" actuator="RElbowRoll" mute="false" unit="radian">
    <Key value="0.5" frame="1">
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.2" frame="15">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.2" frame="65">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.5" frame="84">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.5" frame="90">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
  </ActuatorCurve>

  <ActuatorCurve fps="25" actuator="HeadYaw" mute="false" unit="radian">
    <Key value="0.0" frame="1">
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.0" frame="90">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
  </ActuatorCurve>

  <ActuatorCurve fps="25" actuator="HeadPitch" mute="false" unit="radian">
    <Key value="0.0" frame="1">
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.1" frame="15">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.3" frame="22">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.15" frame="29">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.3" frame="36">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.15" frame="43">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.3" frame="50">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="-0.15" frame="57">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.3" frame="64">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
      <Tangent side="right" abscissaParam="4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
    <Key value="0.0" frame="90">
      <Tangent side="left" abscissaParam="-4.0" ordinateParam="0" editor:interpType="bezier_auto"/>
    </Key>
  </ActuatorCurve>

</Animation>
