<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="132dp"
            android:layout_height="54dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_description"
            android:scaleType="centerInside"
            android:src="@drawable/sit_logo" />

        <View
            android:layout_width="1dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="20dp"
            android:background="@color/sit_border" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.1"
                android:text="{SIT} QUEST // EXPERIENCE 2026"
                android:textColor="@color/sit_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/robotStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:maxLines="1"
                android:text="PREVIEW MODE // wacht op robotfocus"
                android:textColor="@color/sit_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/resetButton"
            style="@style/Widget.PepperQuest.SecondaryButton"
            android:layout_width="132dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp"
            android:text="@string/reset" />

        <Button
            android:id="@+id/stopButton"
            style="@style/Widget.PepperQuest.StopButton"
            android:layout_width="148dp"
            android:layout_height="64dp"
            android:text="@string/stop" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/sit_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="20dp"
            android:layout_weight="0.82"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/missionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/label_gold"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:letterSpacing="0.08"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="QUEST 00 // STANDBY"
                android:textColor="@color/sit_gold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/big_shoulders_display_extra_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.015"
                android:lineSpacingExtra="-7dp"
                android:text="UNLOCK
STUDENT MODE"
                android:textColor="@color/sit_text"
                android:textSize="55sp" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:lineSpacingExtra="5dp"
                android:maxLines="4"
                android:text="Drie korte missies. Eén community. Start de link en ontdek jouw tech class."
                android:textColor="@color/sit_muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/primaryButton"
                style="@style/Widget.PepperQuest.PrimaryButton"
                android:layout_width="260dp"
                android:layout_height="68dp"
                android:layout_marginTop="24dp"
                android:text="@string/start_quest" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.18"
            android:background="@drawable/terminal_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jetbrains_mono_bold"
                    android:letterSpacing="0.1"
                    android:text="SIT://MISSION_TERMINAL"
                    android:textColor="@color/sit_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_regular"
                    android:text="LOCAL // NO DATA"
                    android:textColor="@color/sit_green"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/feedback"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/terminal_line"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:paddingHorizontal="14dp"
                android:text="SYSTEM READY // druk START QUEST"
                android:textColor="@color/sit_green"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/idlePanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/big_shoulders_display_extra_bold"
                        android:letterSpacing="0.08"
                        android:text="ACCESS LOCKED"
                        android:textColor="@color/sit_text"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/jetbrains_mono_regular"
                        android:text="3 MISSIONS // 60–90 SEC // OFFLINE"
                        android:textColor="@color/sit_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/touchPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_regular"
                        android:text="PHYSICAL SENSOR OF TABLET FALLBACK"
                        android:textColor="@color/sit_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="12dp"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button android:id="@+id/touchHead" style="@style/Widget.PepperQuest.TouchPad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="01
HEAD" />
                        <Button android:id="@+id/touchLeft" style="@style/Widget.PepperQuest.TouchPad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:text="02
L HAND" />
                        <Button android:id="@+id/touchRight" style="@style/Widget.PepperQuest.TouchPad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:text="03
R HAND" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/voicePanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_regular"
                        android:text="VOICE ACTIVE // OF KIES EEN CHIP"
                        android:textColor="@color/sit_cyan"
                        android:textSize="12sp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                            <Button android:id="@+id/classSoftware" style="@style/Widget.PepperQuest.ClassChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_marginBottom="5dp" android:layout_weight="1" android:text="SOFTWARE" />
                            <Button android:id="@+id/classCyber" style="@style/Widget.PepperQuest.ClassChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_marginBottom="5dp" android:layout_weight="1" android:text="CYBER" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                            <Button android:id="@+id/classDesign" style="@style/Widget.PepperQuest.ClassChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="UX + DESIGN" />
                            <Button android:id="@+id/classGames" style="@style/Widget.PepperQuest.ClassChip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginTop="5dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="GAMES" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resultPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/result_card"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/jetbrains_mono_bold" android:text="CLASS IDENTIFIED" android:textColor="@color/sit_gold" android:textSize="12sp" />
                    <TextView android:id="@+id/resultTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="@font/big_shoulders_display_extra_bold" android:letterSpacing="0.05" android:text="CODE ARCHITECT" android:textColor="@color/sit_text" android:textSize="36sp" />
                    <TextView android:id="@+id/resultCopy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="@font/jetbrains_mono_regular" android:lineSpacingExtra="4dp" android:textColor="@color/sit_muted" android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:background="@drawable/footer_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <LinearLayout android:layout_width="236dp" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/jetbrains_mono_bold" android:text="MISSION PROGRESS" android:textColor="@color/sit_muted" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp" android:orientation="horizontal">
                <View android:id="@+id/progressOne" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/progress_idle" />
                <View android:id="@+id/progressTwo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="5dp" android:layout_weight="1" android:background="@drawable/progress_idle" />
                <View android:id="@+id/progressThree" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/progress_idle" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="50dp" android:layout_marginHorizontal="22dp" android:background="@color/sit_border" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/jetbrains_mono_bold" android:gravity="center" android:text="€10 / JAAR" android:textColor="@color/sit_text" android:textSize="16sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/jetbrains_mono_bold" android:gravity="center" android:text="50+ EVENTS" android:textColor="@color/sit_text" android:textSize="16sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:fontFamily="@font/jetbrains_mono_bold" android:gravity="center" android:text="DOOR STUDENTEN
VOOR STUDENTEN" android:textColor="@color/sit_text" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
