  "intent": {
    "businessValue": "SIT wordt zichtbaar en memorabel als de studentgedreven tech-community van HBO-ICT",
    "nonGoals": [
      "Geen cloud-AI, gezichtsopslag, internetafhankelijkheid, fysieke LED-control of rijdende Pepper-basis"
    ],
    "outcome": "Een lokaal installeerbare Pepper Android-app levert morgen een complete 60-90 seconden SIT Quest via tablet, stem, hoofd- en handtouch en veilige robotanimaties",
    "problem": "Eerstejaars en studiekiezers ervaren SIT nog niet als een speelse tech-community tijdens HvA Experience",
